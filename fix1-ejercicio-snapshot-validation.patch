+/**
+ * Parsea overrides manuales (--sol=X --bybit=Y --binance=Z --rate=R) desde argv.
+ */
+function parseSnapshotOverrides(args) {
+    const out = {};
+    for (const a of args) {
+        if (a.startsWith('--sol=')) {
+            const v = parseFloat(a.split('=')[1]);
+            if (!isNaN(v) && v >= 0) out.customSol = v;
+        } else if (a.startsWith('--bybit=')) {
+            const v = parseFloat(a.split('=')[1]);
+            if (!isNaN(v) && v >= 0) out.customBybit = v;
+        } else if (a.startsWith('--binance=')) {
+            const v = parseFloat(a.split('=')[1]);
+            if (!isNaN(v) && v >= 0) out.customBinance = v;
+        } else if (a.startsWith('--rate=')) {
+            const v = parseFloat(a.split('=')[1]);
+            if (!isNaN(v) && v > 0) out.customRate = v;
+        }
+    }
+    return out;
+}
+
+/**
+ * Imprime los errores del snapshot en consola y devuelve true si el snapshot es seguro para persistir.
+ * Si no es seguro y no se pasó --force-partial, devuelve false y el caller debe abortar.
+ */
+function validateSnapshot(snap, args, operacion) {
+    if (snap.fullyTrusted && snap.errors.length === 0) return true;
+
+    console.log('\n================================================================================');
+    console.log(` ⚠️  SNAPSHOT INCOMPLETO AL INTENTAR ${operacion.toUpperCase()}`);
+    console.log('================================================================================');
+    for (const err of snap.errors) {
+        console.log(` ❌ [${err.src}] ${err.msg}`);
+    }
+    console.log('--------------------------------------------------------------------------------');
+    console.log(' Estado de confianza por fuente:');
+    console.log(`   • Tasa promedio:   ${snap.rates.trusted ? '✅' : '❌'}  (${snap.rates.rateAvg} BOB/USDT)`);
+    console.log(`   • Banco Sol:       ${snap.balances.bancoSolTrusted ? '✅' : '❌'}  (${formatNum(snap.balances.bancoSolBob)} BOB${snap.balances.bancoSolSource ? ` — fuente: ${snap.balances.bancoSolSource}` : ''})`);
+    console.log(`   • Bybit USDT:      ${snap.balances.bybitTrusted ? '✅' : '❌'}  (${formatNum(snap.balances.bybitUsdt)} USDT)`);
+    console.log(`   • Binance USDT:    ${snap.balances.binanceTrusted ? '✅' : '❌'}  (${formatNum(snap.balances.binanceUsdt)} USDT)`);
+    console.log('--------------------------------------------------------------------------------');
+
+    if (args.includes('--force-partial')) {
+        console.log(' ⚠️  --force-partial detectado: se persistirá con los datos parciales mostrados.');
+        console.log('    El ROI calculado al cerrar puede estar sesgado si alguno de los campos es incorrecto.');
+        console.log('================================================================================\n');
+        return true;
+    }
+
+    console.log(' 🛑 OPERACIÓN ABORTADA. Opciones para continuar:');
+    console.log('    1. Reintenta en unos segundos:    node ejercicio.js --' + operacion);
+    console.log('    2. Fuerza valores faltantes con flags manuales:');
+    console.log('         --sol=1500      (Banco Sol en BOB)');
+    console.log('         --bybit=120     (Saldo Bybit en USDT)');
+    console.log('         --binance=240   (Saldo Binance en USDT)');
+    console.log('         --rate=12.05    (Tasa manual BOB/USDT)');
+    console.log('    3. Acepta registrar con lo que hay:    agrega --force-partial');
+    console.log('================================================================================\n');
+    return false;
+}
